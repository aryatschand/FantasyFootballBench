# Required: OpenRouter API key used for every model call.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: attribution headers sent to OpenRouter (shows up on their rankings page).
FFBENCH_SITE_URL=https://fantasyfootballbench.local
FFBENCH_SITE_TITLE=FantasyFootballBench

# Optional: path to an alternate league config (defaults to ./config.json).
# FFBENCH_CONFIG=./configs/standard_scoring.json

# Optional: reuse an existing simulation id instead of creating a new one.
# FFBENCH_SIM_ID=simulation_20241020_174956

# Optional: fallback model for start/sit calls when a team has no model bound.
# FFBENCH_STARTSIT_MODEL=openai/gpt-5-mini
